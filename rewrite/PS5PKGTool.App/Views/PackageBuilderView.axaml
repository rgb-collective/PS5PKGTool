<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PS5PKGTool.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PS5PKGTool.App.Views.PackageBuilderView"
             x:DataType="vm:PackageBuilderViewModel">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="Package Builder (FPKG)" FontSize="20" FontWeight="Bold" />

            <DockPanel LastChildFill="True" Margin="0,8">
                <TextBlock DockPanel.Dock="Left" Text="Source Folder:" Width="100" VerticalAlignment="Center" />
                <TextBox DockPanel.Dock="Right" Text="{Binding SourcePath}" Watermark="Select dump folder..." />
            </DockPanel>

            <DockPanel LastChildFill="True" Margin="0,8">
                <TextBlock DockPanel.Dock="Left" Text="Output Path:" Width="100" VerticalAlignment="Center" />
                <TextBox DockPanel.Dock="Right" Text="{Binding OutputPath}" Watermark="Output .pkg path..." />
            </DockPanel>

            <DockPanel LastChildFill="True" Margin="0,8">
                <TextBlock DockPanel.Dock="Left" Text="Content ID:" Width="100" VerticalAlignment="Center" />
                <TextBox DockPanel.Dock="Right" Text="{Binding ContentId}" Watermark="Read from param.json..." />
            </DockPanel>

            <DockPanel LastChildFill="True" Margin="0,8">
                <TextBlock DockPanel.Dock="Left" Text="Passcode:" Width="100" VerticalAlignment="Center" />
                <TextBox DockPanel.Dock="Right" Text="{Binding Passcode}" Watermark="Debug passcode..." />
            </DockPanel>

            <Button Content="Build Package" Command="{Binding BuildCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,8" />
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Margin="0,8" />
            <TextBlock Text="{Binding Status}" Foreground="Gray" />
        </StackPanel>
    </DockPanel>
</UserControl>
